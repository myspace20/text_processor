<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>


<AnchorPane prefHeight="650.0" prefWidth="1153.0" style="-fx-background-color: #f9fafb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.text_processor.auto_text_processor.controllers.EditorController">
  <children>

    <Label layoutX="29.0" layoutY="10.0" style="-fx-text-fill: #111827;" text="Text Processor">
      <font>
        <Font name="System Bold" size="24.0" />
      </font>
    </Label>

    <HBox layoutX="870.0" layoutY="18.0" spacing="10.0">
      <children>
        <Button mnemonicParsing="false" onMouseClicked="#onOpenFile" style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827;" text="Read File" />
        <Button mnemonicParsing="false" onMouseClicked="#onSaveToFile" style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827;" text="Save As" />
        <Button mnemonicParsing="false" onMouseClicked="#onSummarize" style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827;" text="Summarize" />
      </children>
    </HBox>

    <HBox layoutX="0.0" layoutY="50.0" prefHeight="600.0" prefWidth="1153.0">

      <AnchorPane prefWidth="250.0" style="-fx-background-color: #f3f4f6;">
        <children>
          <Label layoutX="10.0" layoutY="10.0" style="-fx-text-fill: #111827;" text="Explorer">
            <font>
              <Font name="System Bold" size="14.0" />
            </font>
          </Label>
          <TreeView fx:id="treeView" layoutX="10.0" layoutY="30.0" prefHeight="560.0" prefWidth="230.0" />
        </children>
      </AnchorPane>

      <AnchorPane prefWidth="903.0" style="-fx-background-color: transparent;">
        <children>

          <Label layoutX="20.0" layoutY="10.0" style="-fx-text-fill: #1f2937;" text="Check for matches with regex">
            <font>
              <Font name="System Bold" size="14.0" />
            </font>
          </Label>
          <HBox layoutX="20.0" layoutY="30.0" spacing="10.0">
            <children>
              <TextField fx:id="regexField" prefWidth="200.0" promptText="Enter regex pattern..." style="-fx-background-color: #ffffff; -fx-text-fill: #111827;" />
              <Button fx:id="checkPattern" onMouseClicked="#onMatchPattern" style="-fx-background-color: #d1fae5; -fx-text-fill: #065f46;" text="Check" />
            </children>
          </HBox>

          <Label fx:id="totalMatches" layoutX="20.0" layoutY="70.0" style="-fx-text-fill: #6b7280;" text="No matches found" />
          <ListView fx:id="matchedList" layoutX="20.0" layoutY="90.0" prefHeight="80.0" prefWidth="280.0" style="-fx-control-inner-background: #ffffff; -fx-text-fill: #111827;" />

          <VBox layoutX="318.0" layoutY="10.0" spacing="10.0">
            <children>
              <Label style="-fx-text-fill: #1f2937;" text="Replace text">
                <font><Font name="System Bold" size="14.0" /></font>
              </Label>
              <HBox spacing="10.0">
                <TextField fx:id="replacementField" prefWidth="200.0" promptText="Enter replacement text..." style="-fx-background-color: #ffffff; -fx-text-fill: #111827;" />
                <Button fx:id="replaceButton" onMouseClicked="#onReplaceMatches" style="-fx-background-color: #dbeafe; -fx-text-fill: #1e3a8a;" text="Replace" />
              </HBox>
              <Label style="-fx-text-fill: #374151;" text="Word frequency analysis" />
              <HBox spacing="10.0">
                <TextField fx:id="wordFrequency" prefWidth="200.0" promptText="Enter word to analyze..." style="-fx-background-color: #ffffff; -fx-text-fill: #111827;" />
                <Button fx:id="countFrequency" onMouseClicked="#onFrequencyAnalysis" style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e;" text="Count" />
              </HBox>
            </children>
          </VBox>

          <TextArea fx:id="mainTextArea" layoutX="20.0" layoutY="180.0" prefHeight="300.0" prefWidth="860.0" promptText="Enter or paste text here..." style="-fx-control-inner-background: #ffffff; -fx-text-fill: #111827;" />

          <SplitPane fx:id="comparisonSplitPane" dividerPositions="0.5" layoutX="20.0" layoutY="180.0" prefHeight="300.0" prefWidth="860.0" visible="false">
            <items>
              <TextArea fx:id="originalTextArea" promptText="Original text here..." style="-fx-control-inner-background: #f3f4f6; -fx-text-fill: #111827;" />
              <TextArea fx:id="changedTextArea" promptText="Modified text here..." style="-fx-control-inner-background: #f3f4f6; -fx-text-fill: #111827;" />
            </items>
          </SplitPane>

          <Button fx:id="backButton" layoutX="400.0" layoutY="500.0" onAction="#onBackToMain" prefWidth="150.0" style="-fx-background-color: #e0f2fe; -fx-text-fill: #0369a1;" text="Back to Editor" visible="false" />

          <HBox layoutX="635.0" layoutY="500.0" spacing="10.0">
            <children>
              <Button fx:id="compare" onMouseClicked="#onCompareAndReplace" style="-fx-background-color: #ede9fe; -fx-text-fill: #5b21b6;" text="Compare and Replace" />
              <Button onMouseClicked="#onAcceptChanges" style="-fx-background-color: #dcfce7; -fx-text-fill: #166534;" text="Accept Changes" />
            </children>
          </HBox>
          <HBox layoutX="20.0" layoutY="500.0" prefHeight="26.0" prefWidth="238.0" spacing="10.0">
            <children>
              <Button mnemonicParsing="false" onMouseClicked="#undo" style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827;" text="Undo" />
              <Button mnemonicParsing="false" onMouseClicked="#redo" style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827;" text="Redo" />
              <Button layoutX="66.0" layoutY="10.0" mnemonicParsing="false" onMouseClicked="#onDelete" style="-fx-background-color: #c62828; -fx-text-fill: white; " text="Delete from storage" />
            </children>
          </HBox>

        </children>
      </AnchorPane>
    </HBox>

  </children>
</AnchorPane>